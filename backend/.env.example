# Адрес ClickHouse с точки зрения контейнера (контейнер запускается с --network host)
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=sales_app
CLICKHOUSE_PASSWORD=придумайте-длинный-пароль

# Токен, который вводится в приложении. Сгенерировать: openssl rand -hex 32
SALES_API_TOKEN=

# Кэш готовых разделов в минутах и параллельность запросов (сервер двухъядерный)
CACHE_MINUTES=30
MAX_PARALLEL_QUERIES=2
QUERY_TIMEOUT_S=90
# Прогрев разделов «Месяц» и «7 дней» в фоне
WARMUP=1

DIRECT_LOGIN=Kixbox-cnx
METRIKA_SITE=kixbox.ru
